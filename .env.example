# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/lura"

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://luraenergy.com"
NODE_ENV="production"

# --- Email notifications (optional) ---
# If SMTP_HOST is unset, lead emails are skipped silently.
# Works with any provider: Gmail, SendGrid, Resend, Postmark, Mailgun, plain SMTP.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_SECURE="false"

# Where lead notifications are delivered
LEAD_NOTIFY_TO="ops@luraenergy.com"

# From: address shown on outbound mail
LEAD_NOTIFY_FROM="noreply@luraenergy.com"

# Subject line prefix so leads are easy to filter in the inbox
LEAD_NOTIFY_SUBJECT_PREFIX="[Lura Lead]"